# kr-kit 환경변수 예시 — 이 파일을 복사해 `.env` 로 만들고 값을 채우세요.
#   cp .env.example .env      (Windows PowerShell: Copy-Item .env.example .env)
# `.env` 는 .gitignore 되어 커밋되지 않습니다. 절대 인증키를 코드/예시 파일에 넣지 마세요.

# data.go.kr 「한국천문연구원_특일 정보」 활용신청 후 받은 인증키.
# ⚠️ 반드시 "일반 인증키(Decoding)" 를 넣을 것 — Encoding 키를 넣으면 이중 인코딩으로 인증 오류가 납니다.
# 쓰임: `pnpm fetch:holidays`(공휴일 데이터 생성), `pnpm verify:holidays`(API 와 일치 검증).
DATA_GO_KR_SERVICE_KEY=

# (선택) 특일정보 API 엔드포인트. 보통 비워두면 됩니다. data.go.kr 이 base URL 을 바꾼 경우에만 설정.
# DATA_GO_KR_HOLIDAY_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService/getRestDeInfo
